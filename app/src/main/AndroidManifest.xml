<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/music_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/music_app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.splashScreenTheme">
        <activity
            android:name=".ui.screens.base_screens.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyFilimApp"
            tools:targetApi="30">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".utility.media.MusicPlayerService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
    </application>

</manifest>